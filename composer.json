{
  "name": "aliziodev/laravel-indonesia-regions",
  "description": "Laravel package for Indonesia regions selection with postal codes | Package Laravel untuk pemilihan wilayah Indonesia lengkap dengan kode pos",
  "keywords": [
    "laravel",
    "indonesia",
    "regions",
    "wilayah",
    "provinsi",
    "kabupaten",
    "kecamatan",
    "desa",
    "kelurahan",
    "kodepos",
    "postal-code",
    "indonesia-regions"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Aliziodev",
      "email": "aliziodev@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2|^8.3|^8.4",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.8|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0",
    "laravel/pint": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "Aliziodev\\IndonesiaRegions\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aliziodev\\IndonesiaRegions\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Aliziodev\\IndonesiaRegions\\IndonesiaRegionsServiceProvider"
      ],
      "aliases": {
        "Indonesia": "Aliziodev\\IndonesiaRegions\\Facades\\Indonesia"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/aliziodev"
    }
  ],
  "support": {
    "issues": "https://github.com/aliziodev/laravel-indonesia-regions/issues",
    "source": "https://github.com/aliziodev/laravel-indonesia-regions"
  }
}
